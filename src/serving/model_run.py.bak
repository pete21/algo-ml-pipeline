def create_pydantic_model_from_signature(schema: mlflow.types.schema.Schema, name: str) -> Type[pydantic.BaseModel]:
    """
    Loads an MLflow model's metadata and dynamically constructs a Pydantic 
    BaseModel class matching its input signature.
    """
    
    if not schema:
        raise ValueError(f"The schema does not have an input/output signature defined.")
        
    # Extract the schema inputs
    inputs = schema.to_dict()
    
    # Construct fields dictionary for pydantic.create_model
    # Format: { "field_name": (type_hint, Field_configuration) }
    fields_spec: Dict[str, Any] = {}
    
    for field in inputs:
        name = field.get("name")
        mlflow_type = field.get("type")
        
        # fallback to Any if type is unrecognized
        python_type = MLFLOW_TYPE_MAP.get(mlflow_type, Any)
        
        # Enforce required vs optional based on your needs 
        # (MLflow schemas don't flag fields as required, we default to required here)
        fields_spec[name] = (python_type, pydantic.Field(..., description=f"MLflow type: {mlflow_type}"))
        
    # Dynamically build and return the Pydantic BaseModel subclass
    return pydantic.create_model(name, **fields_spec)



def get_req_resp_signatures(model_signature: mlflow.models.ModelSignature) -> tuple[pydantic.BaseModel, pydantic.BaseModel]:
    inputs: mlflow.types.schema.Schema = model_signature.inputs
    # outputs: mlflow.types.schema.Schema = model_signature.outputs

    # return (schema_to_pydantic(inputs, name="InputModel"), schema_to_pydantic(outputs, name="OutputModel"))
    return create_pydantic_model_from_signature(inputs, name="InputModel") #, create_pydantic_model_from_signature(outputs, name="OutputModel"))


def deployment_from_model_name_and_alias(registered_model_name: str, model_version_alias: str):

    model_version_info = client.get_model_version_by_alias(registered_model_name, model_version_alias)
    print(model_version_info)

    # Get the model version using a model URI
    # model_uri = f"models:/{registered_model_name}@{model_version_alias}"
    model_uri = model_version_info.source
    print(model_uri)

    model_info = get_model_info(model_uri)
    print(model_info)
    # model_info = mlflow.models.get_model_info(f"models:/{model_name}/{default_version}")
    input_datamodel: Type[pydantic.BaseModel] = get_req_resp_signatures(model_info.signature)
    # Inspect your newly created model schema
    print("Generated Pydantic Schema JSON:")
    print(input_datamodel.model_json_schema())
    print(input_datamodel.model_fields)
    # print(output_datamodel)



    app = FastAPI()


    @serve.deployment(name=registered_model_name)
    @serve.ingress(app)
    class DynamicallyDefinedDeployment:

        # MODEL_NAME: str = registered_model_name

        @serve.multiplexed(max_num_models_per_replica=2)
        async def get_model(self, model_uri: str):

            try:
                model = mlflow.xgboost.load_model(model_uri)
                # print(model)
            except Exception as e:
                raise RuntimeError(f"Failed to load model from {model_uri}: {e}")

            if model.metadata.get_model_info().signature != model_info.signature:
                raise ValueError(f"Incompatible signature")
            return model

        # TODO: Extend this to support batching (lists of inputs and outputs)

        @app.post("/serve") #, response_model=list[output_datamodel])
        async def serve(self, model_input: input_datamodel, response: Response):
            model_id = serve.get_multiplexed_model_id()
            if model_id == "":
                model_id = model_version_info.source

            try:
                model = await self.get_model(model_id)
            except ValueError:
                response.status_code = status.HTTP_409_CONFLICT
                return [{"error": "Model loading failed"}]

            return model.predict(model_input.dict())

    return DynamicallyDefinedDeployment



deployment = deployment_from_model_name_and_alias(registered_model_name, model_version_alias)

serve.run(deployment.bind(), blocking=False)





